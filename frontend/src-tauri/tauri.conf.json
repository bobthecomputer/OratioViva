{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OratioViva",
  "version": "1.0.0",
  "identifier": "com.oratioviva.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --host --port 5173 --mode tauri",
    "beforeBuildCommand": "npm run build -- --mode tauri",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OratioViva",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": [
      "../../backend"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
